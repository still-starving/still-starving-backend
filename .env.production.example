# Production Environment Configuration Template
# Copy this to .env and fill in your production values

# Environment
APP_ENV=production

# Database Configuration
DB_HOST=your-postgres-host.example.com
DB_PORT=5432
DB_USER=food_sharing_user
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
DB_NAME=food_sharing
DB_SSLMODE=require

# MinIO Configuration
MINIO_ENDPOINT=your-minio-host.example.com:9000
MINIO_ACCESS_KEY=CHANGE_ME_ACCESS_KEY
MINIO_SECRET_KEY=CHANGE_ME_SECRET_KEY
MINIO_BUCKET=food-images
MINIO_USE_SSL=true
MINIO_PUBLIC_URL=https://your-minio-host.example.com

# JWT Configuration
JWT_SECRET=CHANGE_ME_GENERATE_STRONG_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_EXPIRATION=24h

# Server Configuration
PORT=8000
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# File Upload Configuration
MAX_UPLOAD_SIZE=5242880
